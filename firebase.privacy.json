{
  "hosting": {
    "site": "baj-epod-privacy",
    "public": "privacy-site/public",
    "ignore": ["firebase.privacy.json", "**/.*", "**/node_modules/**"],
    "headers": [
      {
        "source": "**",
        "headers": [
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "Cache-Control", "value": "public, max-age=300" }
        ]
      }
    ]
  }
}
